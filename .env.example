# ------------------------------------------------------------------
# FlowPay Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# Neon PostgreSQL connection string (Prisma).
# Use the *pooled* Neon connection string with `sslmode=require`.
# `pgbouncer=true` tells Prisma it is talking to a connection pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-REGION.pooler.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Auth.js secret used to sign session cookies / JWT.
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Base URL of the application (used for callbacks/links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"